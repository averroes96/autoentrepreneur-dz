datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id         String   @id @default(uuid())
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users               User[]
  profile             AutoEntrepreneurProfile?
  clients             Client[]
  invoices            Invoice[]
  invoiceSequences    InvoiceSequence[]
  quotes              Quote[]
  quoteSequences      QuoteSequence[]
  creditNotes         CreditNote[]
  creditNoteSequences CreditNoteSequence[]
  pastTurnovers       PastTurnover[]
  expenses            Expense[]
  accountantAccesses  AccountantAccess[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AutoEntrepreneurProfile {
  id                 String    @id @default(uuid())
  tenantId           String    @unique
  fullName           String
  rnaeNumber         String
  nif                String
  address            String
  email              String
  phone              String
  activityCode       String
  activityLabel      String
  defaultCurrency    String    @default("DZD")
  cardIssueDate      DateTime?
  activityStartDate  DateTime?
  cardValidityYears  Int       @default(5)
  casnosStatus       String    @default("AFFILIATED") // AFFILIATED, PENDING, EXEMPT
  casnosScheme       String    @default("FLAT_24000") // FLAT_24000, STANDARD
  vatExemptionNote   String    @default("Exonéré de la TVA en vertu de la loi n° 22-23 relative au statut de l'auto-entrepreneur et du Code des Impôts Directs.")
  invoicePrefix      String    @default("FAC")
  quotePrefix        String    @default("DEV")
  creditNotePrefix   String    @default("AVR")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Client {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  clientType  String       @default("PROFESSIONAL") // PROFESSIONAL, INDIVIDUAL
  address     String
  nif         String?
  nis         String?
  rc          String?
  email       String?
  phone       String?
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
  quotes      Quote[]
  creditNotes CreditNote[]

  @@index([tenantId])
}

model InvoiceSequence {
  id           String @id @default(uuid())
  tenantId     String
  fiscalYear   Int
  lastSequence Int    @default(0)

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fiscalYear])
}

model Invoice {
  id                 String    @id @default(uuid())
  tenantId           String
  clientId           String
  invoiceNumber      String?
  sequenceNumber     Int?
  fiscalYear         Int
  status             String    @default("DRAFT") // DRAFT, ISSUED, CANCELLED
  paymentStatus      String    @default("UNPAID") // UNPAID, PAID
  issueDate          DateTime
  paidAt             DateTime?
  paymentMethod      String?   // CASH, BANK_TRANSFER, CCP_BARIDIMOB, CHEQUE
  paymentReference   String?   // Transaction or check reference
  receiptNumber      String?   // REC-YYYY-XXXX
  currency           String    @default("DZD")
  exchangeRate       Float?    @default(1.0)
  total              Float     @default(0)
  totalDzd           Float?    @default(0)
  vatExemptionNote   String
  sellerSnapshot     String?   // JSON snapshot of profile when issued
  clientSnapshot     String?   // JSON snapshot of client when issued
  issuedAt           DateTime?
  cancellationReason String?
  notes              String?
  showDetailedItems  Boolean   @default(false)
  sourceQuoteId      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client             Client            @relation(fields: [clientId], references: [id])
  lineItems          InvoiceLineItem[]
  sourceQuote        Quote?            @relation(fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  creditNotes        CreditNote[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([sourceQuoteId])
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  totalPrice  Float
  currency    String  @default("DZD")
  position    Int     @default(0)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Quote {
  id                 String          @id @default(uuid())
  tenantId           String
  clientId           String
  quoteNumber        String?
  sequenceNumber     Int?
  fiscalYear         Int
  status             String          @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED, CONVERTED
  issueDate          DateTime
  validUntil         DateTime?
  currency           String          @default("DZD")
  exchangeRate       Float?          @default(1.0)
  total              Float           @default(0)
  totalDzd           Float?          @default(0)
  notes              String?
  vatExemptionNote   String
  showDetailedItems  Boolean         @default(false)
  sellerSnapshot     String?
  clientSnapshot     String?
  sentAt             DateTime?
  convertedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client             Client          @relation(fields: [clientId], references: [id])
  lineItems          QuoteLineItem[]
  invoices           Invoice[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([clientId])
}

model QuoteLineItem {
  id          String  @id @default(uuid())
  quoteId     String
  description String
  quantity    Float
  unitPrice   Float
  totalPrice  Float
  currency    String  @default("DZD")
  position    Int     @default(0)

  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteSequence {
  id           String @id @default(uuid())
  tenantId     String
  fiscalYear   Int
  lastSequence Int    @default(0)

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fiscalYear])
}

model CreditNote {
  id                 String               @id @default(uuid())
  tenantId           String
  clientId           String
  originalInvoiceId  String
  creditNoteNumber   String?
  sequenceNumber     Int?
  fiscalYear         Int
  status             String               @default("DRAFT") // DRAFT, ISSUED
  refundStatus       String               @default("PENDING") // PENDING, REFUNDED
  issueDate          DateTime
  refundedAt         DateTime?
  reason             String
  currency           String               @default("DZD")
  exchangeRate       Float?               @default(1.0)
  total              Float                @default(0)
  totalDzd           Float?               @default(0)
  notes              String?
  vatExemptionNote   String
  sellerSnapshot     String?
  clientSnapshot     String?
  issuedAt           DateTime?
  showDetailedItems  Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client             Client               @relation(fields: [clientId], references: [id])
  originalInvoice    Invoice              @relation(fields: [originalInvoiceId], references: [id], onDelete: Restrict)
  lineItems          CreditNoteLineItem[]

  @@unique([tenantId, creditNoteNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([originalInvoiceId])
}

model CreditNoteLineItem {
  id           String     @id @default(uuid())
  creditNoteId String
  description  String
  quantity     Float
  unitPrice    Float
  totalPrice   Float
  currency     String     @default("DZD")
  position     Int        @default(0)

  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
}

model CreditNoteSequence {
  id           String @id @default(uuid())
  tenantId     String
  fiscalYear   Int
  lastSequence Int    @default(0)

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fiscalYear])
}

model PastTurnover {
  id          String   @id @default(uuid())
  tenantId    String
  fiscalYear  Int
  turnoverDzd Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fiscalYear])
}

model Expense {
  id            String    @id @default(uuid())
  tenantId      String
  title         String
  amount        Float
  currency      String    @default("DZD")
  exchangeRate  Float?    @default(1.0)
  amountDzd     Float?    @default(0)
  date          DateTime
  fiscalYear    Int
  category      String
  paymentMethod String    @default("OTHER")
  supplier      String?
  invoiceNumber String?
  receiptUrl    String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, fiscalYear])
  @@index([tenantId, category])
  @@index([tenantId, date])
}

model AccountantAccess {
  id              String    @id @default(uuid())
  tenantId        String
  token           String    @unique
  pinHash         String?
  name            String
  email           String?
  fiscalYear      Int?
  expiresAt       DateTime?
  isRevoked       Boolean   @default(false)
  lastAccessedAt  DateTime?
  accessCount     Int       @default(0)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([token])
}

